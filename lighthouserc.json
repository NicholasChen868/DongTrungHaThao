{
    "ci": {
        "collect": {
            "staticDistDir": "./dist",
            "url": [
                "http://localhost/index.html",
                "http://localhost/tuyen-ctv.html"
            ]
        },
        "assert": {
            "assertions": {
                "categories:performance": [
                    "warn",
                    {
                        "minScore": 0.9
                    }
                ],
                "categories:accessibility": [
                    "warn",
                    {
                        "minScore": 0.85
                    }
                ],
                "categories:best-practices": [
                    "warn",
                    {
                        "minScore": 0.9
                    }
                ],
                "categories:seo": [
                    "warn",
                    {
                        "minScore": 0.9
                    }
                ]
            }
        },
        "upload": {
            "target": "temporary-public-storage"
        }
    }
}